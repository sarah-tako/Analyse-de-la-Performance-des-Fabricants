table Mesure
	lineageTag: 1e170a0c-81a3-476b-8969-c7178ad98b65

	measure Mesure = DISTINCTCOUNT(geography[Country])
		formatString: 0
		lineageTag: f84e1bc8-8afe-49c0-9f55-8af61875b782

	measure 'PY sale' = CALCULATE(SUM(Sales[Revenue]), SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 699278bb-0259-4076-bb1a-637d91c794f0

	measure '% Growth' = ```
			DIVIDE(SUM(Sales[Revenue])-[PY sale],[PY sale]) 
			```
		formatString: #,0.00\ %;-#,0.00\ %;#,0.00\ %
		lineageTag: 1f0df5bc-dcf1-4af1-a941-a41353e71a3a

	column Column
		formatString: 0
		lineageTag: 50ecfac8-aeba-4eed-bfe2-9951850e7913
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Mesure = calculated
		mode: import
		source = Row("Column", BLANK())

